# ============================================
# Employee Management System - Environment Variables
# ============================================
# SECURITY: Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ============================================

# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/ems_db
DB_USERNAME=root
DB_PASSWORD=your_secure_password_here

# JPA Configuration
DDL_AUTO=update
SHOW_SQL=false

# Server Configuration
SERVER_PORT=8080

# ============================================
# Production Checklist:
# ============================================
# [ ] Use strong, unique DB_PASSWORD
# [ ] Set SHOW_SQL=false
# [ ] Set DDL_AUTO=validate (not update)
# [ ] Enable HTTPS
# [ ] Add authentication (Spring Security)
# [ ] Configure firewall rules
# [ ] Set up monitoring and logging
# ============================================
